# Application Configuration
APP_NAME=BitmapInventory
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (MySQL via docker-compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bitmap_inventory
DB_USERNAME=bitmap_user
DB_PASSWORD=bitmap_secret
FORWARD_DB_PORT=3306

# SQLite Alternative (if deploying without MySQL container):
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/database/database.sqlite

# Redis Cache, Queue, and Session
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
FORWARD_REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# Automatic Deployment Flags
RUN_MIGRATIONS=true
SEED_DATABASE=false

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage & File System
FILESYSTEM_DISK=local

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"
